        <mxCell id="p2-19" value="type" style="html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;endSize=10;" edge="1" parent="1" source="p2-3" target="p2-10">
          <mxGeometry relative="1" as="geometry" />
