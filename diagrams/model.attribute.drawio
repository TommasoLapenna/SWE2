        <mxCell id="p2-20" value="1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;" connectable="0" vertex="1" parent="p2-19">
          <mxGeometry x="0.78" relative="1" as="geometry">
            <mxPoint y="-6" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-21" value="component" style="html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;endSize=10;" edge="1" parent="1" source="p2-3" target="p2-15">
