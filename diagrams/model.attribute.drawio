        </mxCell>
        <mxCell id="p2-22" value="0..1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;" connectable="0" vertex="1" parent="p2-21">
          <mxGeometry x="0.78" relative="1" as="geometry">
            <mxPoint y="-6" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-23" value="«use»" style="html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="p2-3" target="p2-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-24" value="«create»" style="html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="p2-17" target="p2-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-25" value="«consume»" style="html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="p2-18" target="p2-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-26" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Observer&lt;/b&gt; (GoF 1994, p. 293), &lt;i&gt;push model&lt;/i&gt;: the subject sends a change description to every observer. The generic base Event&amp;lt;T&amp;gt; (main.pattern.observer, not drawn) is parameterised with an enumeration, giving a type-safe discriminator instead of an int code (Bloch 2018, Item 34).&lt;br&gt;• Event granularity: ADDED / REMOVED are incremental and name the affected component, so observers can re-evaluate only what depends on component.type()." style="shape=note;size=12;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="620" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p2-27" value="&lt;b&gt;Observations&lt;/b&gt;&lt;br&gt;• RESTORED is a &lt;i&gt;wholesale&lt;/i&gt; state replacement and carries component = null; componentType() would therefore throw NullPointerException for it. CompatibilityChecker.update() avoids this by testing the event type first and falling back to evaluateAll().&lt;br&gt;• A sealed event hierarchy (or a Null Object) would make this invariant explicit in the type system." style="shape=note;size=12;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="440" width="560" height="118" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="03 main.domain.model">
    <mxGraphModel dx="1706" dy="1211" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1067" math="0" shadow="0">
      <root>
