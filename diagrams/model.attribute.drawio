          <mxGeometry x="40" y="110" width="130" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2-18" value="&lt;b&gt;CompatibilityChecker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;main.domain.rule&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1">
