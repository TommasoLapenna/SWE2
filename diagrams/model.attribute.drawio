          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-58" value="«use»" style="html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endSize=10;" parent="1" source="p1-14" target="p1-44" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-59" value="«create» x 40" style="html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endSize=10;" parent="1" source="p1-36" target="p1-48" edge="1">
          <mxGeometry relative="1" as="geometry" />
